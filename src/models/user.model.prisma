model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique @db.VarChar(255)
  password          String                 @db.VarChar(255)
  firstName             String                 @db.VarChar(255)
  lastName              String                 @db.VarChar(255)
  phoneNumber           String?                @db.VarChar(50)
  status                UserStatus             @default(PENDING)
  isVerified         Boolean                @default(false)
  lastLoginAt           DateTime?              @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(6)
  closedAt             DateTime?              @db.Timestamptz(6)
  isRegComplete Boolean                @default(true)
  source                String?                @db.VarChar(50)

  advisor               Advisor?
  advisoryNotes         AdvisoryNote[]
  userRoles    UserRole[]
  goals                 Goal[]
  meetingsAsClient  Meeting[]              @relation("ClientMeetings")
  serviceRequests   ServiceRequest[]       @relation("ClientRequests")
  notifications         Notification[]
  assignmentsCreated    ClientAssignment[] @relation("AssignedBy")
  subscription          Subscription?
}
