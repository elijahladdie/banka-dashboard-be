model FinancialReport {
  id           String     @id @default(uuid()) @db.Uuid
  subscriberId String     @db.Uuid
  advisorId    String     @db.Uuid
  title        String     @db.VarChar(255)
  reportType   ReportType @default(MONTHLY)
  fileUrl      String?
  summary      String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  advisor      Advisor    @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  subscriber   User       @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@map("financial_reports")
}
