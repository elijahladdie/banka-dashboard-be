model Advisor {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @unique @db.Uuid
  employeeCode   String                 @unique @db.VarChar(100)
  specialization String?                @db.VarChar(255)
  bio            String?
  maxClients     Int                    @default(20)
  currentClients Int                    @default(0)
  isAvailable    Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?              @db.Timestamptz(6)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisoryNotes  AdvisoryNote[]
  meetings       Meeting[]              @relation("AdvisorMeetings")
  assignments    SubscriberAssignment[] @relation("Advisor")

  @@map("advisors")
}
