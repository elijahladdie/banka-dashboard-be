model Meeting {
  id           String        @id @default(uuid()) @db.Uuid
  advisorId    String        @db.Uuid
  clientId String        @db.Uuid
  title        String        @db.VarChar(255)
  description  String?
  meetingDate  DateTime      @db.Timestamptz(6)
  starts_at    DateTime?
  ends_at      DateTime?
  status       MeetingStatus @default(SCHEDULED)
  meetingLink  String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  advisor      Advisor       @relation("AdvisorMeetings", fields: [advisorId], references: [id], onDelete: Cascade)
  client   User          @relation("ClientMeetings", fields: [clientId], references: [id], onDelete: Cascade)
}
