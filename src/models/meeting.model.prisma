model Meeting {
  id           String        @id @default(uuid()) @db.Uuid
  advisorId    String        @db.Uuid
  subscriberId String        @db.Uuid
  title        String        @db.VarChar(255)
  description  String?
  meetingDate  DateTime      @db.Timestamptz(6)
  status       MeetingStatus @default(SCHEDULED)
  meetingLink  String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  advisor      Advisor       @relation("AdvisorMeetings", fields: [advisorId], references: [id], onDelete: Cascade)
  subscriber   User          @relation("SubscriberMeetings", fields: [subscriberId], references: [id], onDelete: Cascade)

  @@map("meetings")
}
